#!/bin/sh
# Git pre-commit：若改动了 platform/parts 或 build 脚本，则必须 build + check 通过
# 启用: git config core.hooksPath .githooks

set -e
cd "$(git rev-parse --show-toplevel)"

changed="$(git diff --cached --name-only)"
needs=0
echo "$changed" | grep -qE '^platform/parts/' && needs=1
echo "$changed" | grep -qE '^platform/build\.ps1$' && needs=1
echo "$changed" | grep -qE '^platform/check-' && needs=1

if [ "$needs" -eq 0 ]; then
  exit 0
fi

echo "[pre-commit] platform parts changed — running build + check..."
if command -v npm >/dev/null 2>&1; then
  npm run validate
else
  powershell -NoProfile -ExecutionPolicy Bypass -File platform/build.ps1
  node platform/check-all.js
fi

# 若 build 更新了 platform-main.js，自动加入本次提交
git add platform-main.js 2>/dev/null || true
echo "[pre-commit] OK"
